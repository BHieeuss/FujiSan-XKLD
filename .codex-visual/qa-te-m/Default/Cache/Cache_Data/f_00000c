      <!-- \u2500\u2500 D\u1EA0NG 2: GH\xC9P T\u1EEA \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
      <div class="te-wb-area" *ngIf="exerciseType === 'wordBuilder'">\r
\r
        <!-- Hint: how many chars to pick -->\r
        <div class="te-wb-hint">\r
          <span>Ch\u1ECDn \u0111\xFAng <strong>{{ currentVerb.teForm.length }}</strong> \xF4 \u0111\u1EC3 gh\xE9p th\u1EC3 \u3066</span>\r
          <span class="te-wb-counter">{{ wbSelectedTiles.length }}/{{ currentVerb.teForm.length }}</span>\r
        </div>\r
\r
        <!-- Answer zone -->\r
        <div class="te-wb-answer" [class.complete]="wbSelectedTiles.length === currentVerb.teForm.length">\r
          <span\r
            *ngFor="let tile of wbSelectedTiles"\r
            class="te-wb-tile selected"\r
            (click)="unselectWbTile(tile)"\r
          >\r
            {{ tile.char }}\r
          </span>\r
          <span class="te-wb-cursor" *ngIf="!isAnswered && wbSelectedTiles.length < currentVerb.teForm.length">|</span>\r
        </div>\r
\r
        <!-- Available tiles -->\r
        <div class="te-wb-tiles">\r
          <button\r
            *ngFor="let tile of wbAvailableTiles"\r
            type="button"\r
            class="te-wb-tile available"\r
            [class.distractor]="tile.index >= 1000"\r
            [disabled]="isAnswered"\r
            (click)="selectWbTile(tile)"\r
          >\r
            {{ tile.char }}\r
          </button>\r
        </div>\r
\r
        <button\r
          type="button"\r
          class="te-wb-reset"\r
          *ngIf="wbSelectedTiles.length > 0 && !isAnswered"\r
          (click)="resetWordBuilder()"\r
        >\r
          <i class="fas fa-rotate-left"></i> X\u1EBFp l\u1EA1i\r
        </button>\r
      </div>\r
\r
      <!-- \u2500\u2500 D\u1EA0NG 3: G\xD5 PH\xCDM \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
      <div class="te-vk-area" *ngIf="exerciseType === 'virtualKeyboard'">\r
        <!-- Input display -->\r
        <div class="te-vk-input-wrap">\r
          <div class="te-vk-input" [class.has-text]="vkInput.length > 0">\r
            <span *ngIf="!vkInput && !isAnswered" class="te-vk-placeholder">D\xF9ng b\xE0n ph\xEDm b\xEAn d\u01B0\u1EDBi...</span>\r
            <span class="te-vk-text">{{ vkInput }}</span>\r
            <span class="te-vk-blink" *ngIf="!isAnswered">|</span>\r
          </div>\r
          <div class="te-vk-input-actions" *ngIf="!isAnswered">\r
            <button type="button" class="te-vk-btn-clear" (click)="vkClear()" [disabled]="!vkInput">\r
              <i class="fas fa-eraser"></i>\r
            </button>\r
            <button type="button" class="te-vk-btn-submit" (click)="vkSubmit()" [disabled]="!vkInput">\r
              <i class="fas fa-check"></i> Ki\u1EC3m tra\r
            </button>\r
          </div>\r
        </div>\r
\r
        <!-- Virtual Keyboard -->\r
        <div class="te-vk-keyboard" *ngIf="!isAnswered">\r
          <div class="te-vk-mode-toggle">\r
            <button\r
              type="button"\r
              [class.active]="vkKeyboardMode === 'hiragana'"\r
              (click)="vkKeyboardMode = 'hiragana'"\r
            >\r
              \u3042\r
            </button>\r
            <button\r
              type="button"\r
              [class.active]="vkKeyboardMode === 'dakuten'"\r
              (click)="vkKeyboardMode = 'dakuten'"\r
            >\r
              \u304C\u309B\r
            </button>\r
          </div>\r
\r
          <div class="te-vk-rows">\r
            <div class="te-vk-row" *ngFor="let row of currentKeyboardRows">\r
              <button\r
                *ngFor="let key of row"\r
                type="button"\r
                class="te-vk-key"\r
                [class.empty]="!key"\r
                [disabled]="!key"\r
                (click)="vkTypeChar(key)"\r
              >\r
                {{ key }}\r
              </button>\r
            </div>\r
          </div>\r
\r
          <div class="te-vk-bottom-row">\r
            <button type="button" class="te-vk-key te-vk-key-wide" (click)="toggleKeyboardMode()">\r
              {{ vkKeyboardMode === 'hiragana' ? '\u309B\u309C' : '\u3042' }}\r
            </button>\r
            <button type="button" class="te-vk-key te-vk-key-backspace" (click)="vkBackspace()">\r
              <i class="fas fa-delete-left"></i>\r
            </button>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- \u2500\u2500 Correct answer display \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
      <div class="te-correct-display" *ngIf="isAnswered && isCorrect">\r
        <div class="te-correct-badge">\r
          <i class="fas fa-check-circle"></i>\r
          <span>Ch\xEDnh x\xE1c!</span>\r
        </div>\r
        <div class="te-correct-answer">\r
          <span class="te-correct-te">{{ currentVerb.teForm }}</span>\r
          <span class="te-correct-kanji-small">{{ currentVerb.teFormKanji }}</span>\r
        </div>\r
        <div class="te-correct-speak">\r
          <button type="button" (click)="speakJapanese(currentVerb.teForm)" title="Ph\xE1t \xE2m ti\u1EBFng Nh\u1EADt">\r
            <i class="fas fa-volume-high"></i> Nghe l\u1EA1i\r
          </button>\r
        </div>\r
      </div>\r
\r
      <!-- \u2500\u2500 Wrong answer display (inline) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
      <div class="te-wrong-inline" *ngIf="isAnswered && !isCorrect && !showExplanation">\r
        <div class="te-wrong-badge">\r
          <i class="fas fa-times-circle"></i>\r
          <span>Ch\u01B0a \u0111\xFAng</span>\r
        </div>\r
        <div class="te-wrong-correct">\r
          \u0110\xE1p \xE1n: <strong>{{ currentVerb.teForm }}</strong>\r
        </div>\r
        <button type="button" class="te-wrong-explain-btn" (click)="showExplanation = true">\r
          <i class="fas fa-lightbulb"></i> Xem gi\u1EA3i th\xEDch\r
        </button>\r
      </div>\r
\r
      <!-- \u2500\u2500 Next button \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
      <button\r
        *ngIf="isAnswered"\r
        type="button"\r
        class="te-next-btn"\r
        (click)="nextQuestion()"\r
      >\r
        C\xE2u ti\u1EBFp theo\r
        <i class="fas fa-arrow-right"></i>\r
      </button>\r
    </div>\r
  </div>\r
\r
  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r
       EXPLANATION POPUP (khi tr\u1EA3 l\u1EDDi sai)\r
       \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r
  <div class="te-explain-overlay" *ngIf="showExplanation" (click)="closeExplanation()">\r
    <div class="te-explain-popup" (click)="$event.stopPropagation()">\r
      <button type="button" class="te-explain-close" (click)="closeExplanation()">\r
        <i class="fas fa-times"></i>\r
      </button>\r
\r
      <div class="te-explain-header">\r
        <i class="fas fa-graduation-cap"></i>\r
        <span>Gi\u1EA3i th\xEDch chi ti\u1EBFt</span>\r
      </div>\r
\r
      <div class="te-explain-body" *ngIf="explanationData as ed">\r
\r
        <!-- \u2460 Verb intro -->\r
        <div class="te-expl-intro">\r
          <i class="fas fa-circle-info"></i>\r
          <span>{{ ed.verbIntro }}</span>\r
        </div>\r
\r
        <!-- \u2461 Formula -->\r
        <div class="te-expl-formula">\r
          <div class="te-expl-formula-label">C\xF4ng th\u1EE9c</div>\r
          <div class="te-expl-formula-text">{{ ed.formula }}</div>\r
        </div>\r
\r
        <!-- \u2462 Step-by-step application -->\r
        <div class="te-expl-steps">\r
          <div class="te-expl-steps-label">\xC1p d\u1EE5ng</div>\r
          <div class="te-expl-steps-row">\r
            <ng-container *ngFor="let step of ed.steps; let i = index">\r
              <div class="te-expl-step" [class.highlight]="step.highlight">\r
                <small>{{ step.label }}</small>\r
                <span>{{ step.value }}</span>\r
              </div>\r
              <div class="te-expl-arrow" *ngIf="i < ed.steps.length - 1">\u2794</div>\r
            </ng-container>\r
          </div>\r
        </div>\r
\r
        <!-- \u2463 Exception note -->\r
        <div class="te-expl-note" *ngIf="ed.note">\r
          <i class="fas fa-triangle-exclamation"></i>\r
          <span>{{ ed.note }}</span>\r
        </div>\r
\r
        <!-- \u2464 Quick-reference table -->\r
        <div class="te-expl-quickref">\r
          <div class="te-expl-quickref-label">\r
            <i class="fas fa-table-list"></i>\r
            Nh\u1EAFc l\u1EA1i ki\u1EBFn th\u1EE9c \u2014 Nh\xF3m {{ currentVerb.group }}\r
          </div>\r
          <div class="te-expl-quickref-rows">\r
            <div\r
              class="te-expl-quickref-row"\r
              *ngFor="let ref of ed.quickRef"\r
              [class.active]="ed.activePattern && ref.result === ed.activePattern"\r
            >\r
              <span class="te-expl-ref-pattern">{{ ref.pattern }}</span>\r
              <span class="te-expl-ref-arrow">\u2794</span>\r
              <span class="te-expl-ref-result">{{ ref.result }}</span>\r
              <span class="te-expl-ref-example">{{ ref.example }}</span>\r
            </div>\r
          </div>\r
        </div>\r
\r
      </div>\r
\r
      <div class="te-explain-footer">\r
        <button type="button" (click)="speakJapanese(currentVerb.teForm)">\r
          <i class="fas fa-volume-high"></i> Nghe ph\xE1t \xE2m\r
        </button>\r
        <button type="button" class="te-explain-got-it" (click)="closeExplanation()">\r
          \u0110\xE3 hi\u1EC3u <i class="fas fa-check"></i>\r
        </button>\r
      </div>\r
    </div>\r
  </div>\r
\r
\r
  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r
       THEORY VIEW\r
       \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r
  <div class="te-theory" *ngIf="currentView === 'theory'">\r
    <div class="te-theory-header">\r
      <h2>C\xE1ch chia \u0111\u1ED9ng t\u1EEB sang th\u1EC3\u300C\u3066\u300D</h2>\r
      <p>\r
        Th\u1EC3\u300C\u3066\u300Dho\u1EB7c\u300C\u3067\u300Dl\xE0 d\u1EA1ng chia \u0111\u1ED9ng t\u1EEB c\u01A1 b\u1EA3n, d\xF9ng trong nhi\u1EC1u c\u1EA5u tr\xFAc ng\u1EEF ph\xE1p:\r
        li\u1EC7t k\xEA h\xE0nh \u0111\u1ED9ng, xin ph\xE9p, tr\u1EA1ng th\xE1i \u0111ang ti\u1EBFp di\u1EC5n,...\r
      </p>\r
    </div>\r
\r
    <!-- Theory group tabs -->\r
    <div class="te-theory-tabs">\r
      <button\r
        type="button"\r
        [class.active]="theoryActiveGroup === 1"\r
        (click)="theoryActiveGroup = 1"\r
      >\r
        <span class="te-theory-tab-num">I</span>\r
        Nh\xF3m 1 (\u4E94\u6BB5)\r
      </button>\r
      <button\r
        type="button"\r
        [class.active]="theoryActiveGroup === 2"\r
        (click)="theoryActiveGroup = 2"\r
      >\r
        <span class="te-theory-tab-num">II</span>\r
        Nh\xF3m 2 (\u4E00\u6BB5)\r
      </button>\r
      <button\r
        type="button"\r
        [class.active]="theoryActiveGroup === 3"\r
        (click)="theoryActiveGroup = 3"\r
      >\r
        <span class="te-theory-tab-num">III</span>\r
        Nh\xF3m 3 (\u4E0D\u898F\u5247)\r
      </button>\r
    </div>\r
\r
    <!-- \u2500\u2500 GROUP 1 THEORY \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 -->\r
    <div class="te-theory-content" *ngIf="theoryActiveGroup === 1">\r
      <div class="te-theory-intro">\r
        <h3>Nh\xF3m 1 \u2014 \u0110\u1ED9ng t\u1EEB \u4E94\u6BB5 (Godan)</h3>\r
        <p>\xC2m tr\u01B0\u1EDBc\u300C\u307E\u3059\u300Dthu\u1ED9c c\u1ED9t\u300C\u3044\u300D(\u3044\u6BB5). C\xF3 5 quy t\u1EAFc chia kh\xE1c nhau t\xF9y theo \xE2m cu\u1ED1i.</p>\r
      </div>\r
\r
      <!-- Rule: \u3044\u3001\u3061\u3001\u308A \u2192 \u3063\u3066 -->\r
      <div class="te-theory-rule">\r
        <div class="te-theory-rule-head">\r
          <span class="te-theory-rule-badge">\u3044\u30FB\u3061\u30FB\u308A</span>\r
          <span class="te-theory-rule-arrow">\u2192</span>\r
          <span class="te-theory-rule-result">\u3063\u3066</span>\r
        </div>\r
        <p>B\u1ECF\u300C\u307E\u3059\u300D, thay b\u1EB1ng <strong>\u300C\u3063\u3066\u300D</strong></p>\r
        <div class="te-theory-examples">\r
          <div class="te-theory-example" *ngFor="let v of group1TteVerbs">\r
            <span class="te-theory-ex-from">{{ v.hiragana }} <small class="te-kanji-tiny">{{ v.kanji }}</small></span>\r
            <i class="fas fa-arrow-right"></i>\r
            <span class="te-theory-ex-to">{{ v.teForm }} <small class="te-kanji-tiny">{{ v.teFormKanji }}</small></span>\r
            <small>{{ v.meaning }}</small>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- Rule: \u307F\u3001\u3073\u3001\u306B \u2192 \u3093\u3067 -->\r
      <div class="te-theory-rule">\r
        <div class="te-theory-rule-head">\r
          <span class="te-theory-rule-badge">\u307F\u30FB\u3073\u30FB\u306B</span>\r
          <span class="te-theory-rule-arrow">\u2192</span>\r
          <span class="te-theory-rule-result">\u3093\u3067</span>\r
        </div>\r
        <p>B\u1ECF\u300C\u307E\u3059\u300D, thay b\u1EB1ng <strong>\u300C\u3093\u3067\u300D</strong></p>\r
        <div class="te-theory-examples">\r
          <div class="te-theory-example" *ngFor="let v of group1NdeVerbs">\r
            <span class="te-theory-ex-from">{{ v.hiragana }} <small class="te-kanji-tiny">{{ v.kanji }}</small></span>\r
            <i class="fas fa-arrow-right"></i>\r
            <span class="te-theory-ex-to">{{ v.teForm }} <small class="te-kanji-tiny">{{ v.teFormKanji }}</small></span>\r
            <small>{{ v.meaning }}</small>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- Rule: \u304D \u2192 \u3044\u3066 -->\r
      <div class="te-theory-rule">\r
        <div class="te-theory-rule-head">\r
          <span class="te-theory-rule-badge">\u304D</span>\r
          <span class="te-theory-rule-arrow">\u2192</span>\r
          <span class="te-theory-rule-result">\u3044\u3066</span>\r
        </div>\r
        <p>B\u1ECF\u300C\u307E\u3059\u300D, thay b\u1EB1ng <strong>\u300C\u3044\u3066\u300D</strong></p>\r
        <div class="te-theory-examples">\r
          <div class="te-theory-example" *ngFor="let v of group1IteVerbs">\r
            <span class="te-theory-ex-from">{{ v.hiragana }} <small class="te-kanji-tiny">{{ v.kanji }}</small></span>\r
            <i class="fas fa-arrow-right"></i>\r
            <span class="te-theory-ex-to">{{ v.teForm }} <small class="te-kanji-tiny">{{ v.teFormKanji }}</small></span>\r
            <small>{{ v.meaning }}</small>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- Rule: \u304E \u2192 \u3044\u3067 -->\r
      <div class="te-theory-rule">\r
        <div class="te-theory-rule-head">\r
          <span class="te-theory-rule-badge">\u304E</span>\r
          <span class="te-theory-rule-arrow">\u2192</span>\r
          <span class="te-theory-rule-result">\u3044\u3067</span>\r
        </div>\r
        <p>B\u1ECF\u300C\u307E\u3059\u300D, thay b\u1EB1ng <strong>\u300C\u3044\u3067\u300D</strong></p>\r
        <div class="te-theory-examples">\r
          <div class="te-theory-example" *ngFor="let v of group1IdeVerbs">\r
            <span class="te-theory-ex-from">{{ v.hiragana }} <small class="te-kanji-tiny">{{ v.kanji }}</small></span>\r
            <i class="fas fa-arrow-right"></i>\r
            <span class="te-theory-ex-to">{{ v.teForm }} <small class="te-kanji-tiny">{{ v.teFormKanji }}</small></span>\r
            <small>{{ v.meaning }}</small>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- Rule: \u3057 \u2192 \u3057\u3066 -->\r
      <div class="te-theory-rule">\r
        <div class="te-theory-rule-head">\r
          <span class="te-theory-rule-badge">\u3057</span>\r
          <span class="te-theory-rule-arrow">\u2192</span>\r
          <span class="te-theory-rule-result">\u3057\u3066</span>\r
        </div>\r
        <p>B\u1ECF\u300C\u307E\u3059\u300D, th\xEAm <strong>\u300C\u3066\u300D</strong></p>\r
        <div class="te-theory-examples">\r
          <div class="te-theory-example" *ngFor="let v of group1ShiteVerbs">\r
            <span class="te-theory-ex-from">{{ v.hiragana }} <small class="te-kanji-tiny">{{ v.kanji }}</small></span>\r
            <i class="fas fa-arrow-right"></i>\r
            <span class="te-theory-ex-to">{{ v.teForm }} <small class="te-kanji-tiny">{{ v.teFormKanji }}</small></span>\r
            <small>{{ v.meaning }}</small>\r
          </div>\r
        </div>\r
      </div>\r
\r
      <!-- Exception -->\r
      <div class="te-theory-exception">\r
        <div class="te-theory-exception-head">\r
          <i class="fas fa-triangle-exclamation"></i>\r
          <strong>Ngo\u1EA1i l\u1EC7</strong>\r
        </div>\r
        <div class="te-theory-examples">\r
          <div class="te-theory-example" *ngFor="let v of group1ExceptionVerbs">\r
