            <span>Ng\xE0y khai form</span>
            <input type="date" name="formDate" [(ngModel)]="data.formDate" />
          </label>

          <label class="field field-wide">
            <span>H\u1ECD v\xE0 t\xEAn <b>*</b></span>
            <input
              type="text"
              name="fullName"
              [(ngModel)]="data.fullName"
              required
              autocomplete="name"
              placeholder="Nguy\u1EC5n V\u0103n A"
            />
            <small *ngIf="submitted && !data.fullName.trim()">Vui l\xF2ng nh\u1EADp h\u1ECD v\xE0 t\xEAn.</small>
          </label>

          <label class="field">
            <span>Ng\xE0y th\xE1ng n\u0103m sinh</span>
            <input type="date" name="birthDate" [(ngModel)]="data.birthDate" />
          </label>

          <label class="field">
            <span>S\u1ED1 CMT/CCCD <b>*</b></span>
            <input
              type="text"
              name="idNumber"
              [(ngModel)]="data.idNumber"
              required
              inputmode="numeric"
              autocomplete="off"
            />
            <small *ngIf="submitted && !data.idNumber.trim()">Vui l\xF2ng nh\u1EADp s\u1ED1 CMT/CCCD.</small>
          </label>

          <label class="field">
            <span>Ng\xE0y c\u1EA5p CMT/CCCD</span>
            <input type="date" name="idIssueDate" [(ngModel)]="data.idIssueDate" />
          </label>

          <label class="field">
            <span>S\u1ED1 \u0111i\u1EC7n tho\u1EA1i TTS <b>*</b></span>
            <input
              type="tel"
              name="phone"
              [(ngModel)]="data.phone"
              required
              inputmode="tel"
              autocomplete="tel"
              placeholder="09xxxxxxxx"
            />
            <small *ngIf="submitted && !data.phone.trim()">Vui l\xF2ng nh\u1EADp s\u1ED1 \u0111i\u1EC7n tho\u1EA1i.</small>
          </label>

          <label class="field">
            <span>S\u1ED1 \u0111i\u1EC7n tho\u1EA1i ng\u01B0\u1EDDi th\xE2n</span>
            <input
              type="tel"
              name="relativePhone"
              [(ngModel)]="data.relativePhone"
              inputmode="tel"
            />
          </label>

          <label class="field field-full">
            <span>\u0110\u1ECBa ch\u1EC9</span>
            <textarea name="address" [(ngModel)]="data.address" rows="2"></textarea>
          </label>

          <fieldset class="choice-field field-full">
            <legend>T\xECnh tr\u1EA1ng h\xF4n nh\xE2n</legend>
            <div class="choice-row choice-row-four">
              <label>
                <input
                  type="radio"
                  name="maritalStatus"
                  value="married"
                  [(ngModel)]="data.maritalStatus"
                />
                <span>\u0110\xE3 k\u1EBFt h\xF4n</span>
              </label>
              <label>
                <input
                  type="radio"
                  name="maritalStatus"
                  value="separated"
                  [(ngModel)]="data.maritalStatus"
                />
                <span>Ly th\xE2n</span>
              </label>
              <label>
                <input
                  type="radio"
                  name="maritalStatus"
                  value="divorced"
                  [(ngModel)]="data.maritalStatus"
                />
                <span>\u0110\xE3 ly h\xF4n</span>
              </label>
              <label>
                <input
                  type="radio"
                  name="maritalStatus"
                  value="single"
                  [(ngModel)]="data.maritalStatus"
                />
                <span>Ch\u01B0a k\u1EBFt h\xF4n</span>
              </label>
            </div>
          </fieldset>

          <label class="photo-field field-full">
            <span>\u1EA2nh th\u1EBB (kh\xF4ng b\u1EAFt bu\u1ED9c)</span>
            <div class="photo-picker">
              <div class="photo-preview">
                <img *ngIf="photoPreview" [src]="photoPreview" alt="\u1EA2nh th\u1EBB \u0111\xE3 ch\u1ECDn" />
                <i *ngIf="!photoPreview" class="fas fa-user"></i>
              </div>
              <div>
                <input
                  type="file"
                  name="photo"
                  accept="image/png,image/jpeg"
                  (change)="onPhotoSelected($event)"
                />
                <small>Ch\u1ECDn \u1EA3nh JPG ho\u1EB7c PNG, \u1EA3nh s\u1EBD \u0111\u01B0\u1EE3c \u0111\u1EB7t v\xE0o khung tr\xEAn trang 2.</small>
              </div>
            </div>
          </label>
        </div>
      </section>

      <section class="form-card">
        <div class="section-heading">
          <span>02</span>
          <div>
            <h2>S\u1EE9c kh\u1ECFe v\xE0 th\xF3i quen</h2>
            <p>C\xE1c l\u1EF1a ch\u1ECDn C\xF3/Kh\xF4ng s\u1EBD \u0111\u01B0\u1EE3c \u0111\xE1nh d\u1EA5u X trong file Excel.</p>
          </div>
        </div>

        <div class="choice-grid">
          <fieldset class="choice-field">
            <legend>Th\u1ECB l\u1EF1c</legend>
            <div class="choice-row">
              <label>
                <input type="radio" name="eyesight" value="glasses" [(ngModel)]="data.eyesight" />
                <span>C\xF3 k\xEDnh</span>
              </label>
              <label>
                <input
                  type="radio"
                  name="eyesight"
                  value="no-glasses"
                  [(ngModel)]="data.eyesight"
                />
                <span>Kh\xF4ng k\xEDnh</span>
              </label>
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>Thu\u1EADn tay</legend>
            <div class="choice-row">
              <label>
                <input type="radio" name="handedness" value="right" [(ngModel)]="data.handedness" />
                <span>Ph\u1EA3i</span>
              </label>
              <label>
                <input type="radio" name="handedness" value="left" [(ngModel)]="data.handedness" />
                <span>Tr\xE1i</span>
              </label>
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>M\xF9 m\xE0u</legend>
            <div class="choice-row">
              <label
                ><input
                  type="radio"
                  name="colorBlind"
                  value="yes"
                  [(ngModel)]="data.colorBlind"
                /><span>C\xF3</span></label
              >
              <label
                ><input
                  type="radio"
                  name="colorBlind"
                  value="no"
                  [(ngModel)]="data.colorBlind"
                /><span>Kh\xF4ng</span></label
              >
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>Ch\xE2n tay c\xF3 d\u1ECB t\u1EADt kh\xF4ng?</legend>
            <div class="choice-row">
              <label
                ><input
                  type="radio"
                  name="limbDisability"
                  value="yes"
                  [(ngModel)]="data.limbDisability"
                /><span>C\xF3</span></label
              >
              <label
                ><input
                  type="radio"
                  name="limbDisability"
                  value="no"
                  [(ngModel)]="data.limbDisability"
                /><span>Kh\xF4ng</span></label
              >
            </div>
          </fieldset>

          <label class="field">
            <span>Chi\u1EC1u cao (cm)</span>
            <input type="number" name="height" [(ngModel)]="data.height" min="0" />
          </label>
          <label class="field">
            <span>C\xE2n n\u1EB7ng (kg)</span>
            <input type="number" name="weight" [(ngModel)]="data.weight" min="0" />
          </label>

          <fieldset class="choice-field">
            <legend>\u0110\xE3 ph\u1EABu thu\u1EADt l\u1EA7n n\xE0o ch\u01B0a?</legend>
            <div class="choice-row">
              <label
                ><input type="radio" name="surgery" value="yes" [(ngModel)]="data.surgery" /><span
                  >C\xF3</span
                ></label
              >
              <label
                ><input type="radio" name="surgery" value="no" [(ngModel)]="data.surgery" /><span
                  >Kh\xF4ng</span
                ></label
              >
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>Nh\xF3m m\xE1u</legend>
            <div class="choice-row choice-row-four">
              <label
                ><input type="radio" name="bloodType" value="A" [(ngModel)]="data.bloodType" /><span
                  >A</span
                ></label
              >
              <label
                ><input type="radio" name="bloodType" value="B" [(ngModel)]="data.bloodType" /><span
                  >B</span
                ></label
              >
              <label
                ><input
                  type="radio"
                  name="bloodType"
                  value="AB"
                  [(ngModel)]="data.bloodType"
                /><span>AB</span></label
              >
              <label
                ><input type="radio" name="bloodType" value="O" [(ngModel)]="data.bloodType" /><span
                  >O</span
                ></label
              >
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>C\xF3 h\xECnh x\u0103m kh\xF4ng?</legend>
            <div class="choice-row">
              <label
                ><input type="radio" name="tattoo" value="yes" [(ngModel)]="data.tattoo" /><span
                  >C\xF3</span
                ></label
              >
              <label
                ><input type="radio" name="tattoo" value="no" [(ngModel)]="data.tattoo" /><span
                  >Kh\xF4ng</span
                ></label
              >
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>Gia \u0111\xECnh c\xF3 ti\u1EC1n s\u1EED b\u1EC7nh l\xFD?</legend>
            <div class="choice-row">
              <label
                ><input
                  type="radio"
                  name="familyMedicalHistory"
                  value="yes"
                  [(ngModel)]="data.familyMedicalHistory"
                /><span>C\xF3</span></label
              >
              <label
                ><input
                  type="radio"
                  name="familyMedicalHistory"
                  value="no"
                  [(ngModel)]="data.familyMedicalHistory"
                /><span>Kh\xF4ng</span></label
              >
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>C\xF3 u\u1ED1ng bia, r\u01B0\u1EE3u kh\xF4ng?</legend>
            <div class="choice-row">
              <label
                ><input type="radio" name="alcohol" value="yes" [(ngModel)]="data.alcohol" /><span
                  >C\xF3</span
                ></label
              >
              <label
                ><input type="radio" name="alcohol" value="no" [(ngModel)]="data.alcohol" /><span
                  >Kh\xF4ng</span
                ></label
              >
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>C\xF3 h\xFAt thu\u1ED1c kh\xF4ng?</legend>
            <div class="choice-row">
              <label
                ><input type="radio" name="smoking" value="yes" [(ngModel)]="data.smoking" /><span
                  >C\xF3</span
                ></label
              >
              <label
                ><input type="radio" name="smoking" value="no" [(ngModel)]="data.smoking" /><span
                  >Kh\xF4ng</span
                ></label
              >
            </div>
          </fieldset>
        </div>

        <div class="form-grid top-gap">
          <label class="field">
            <span>T\xF4n gi\xE1o</span>
            <input type="text" name="religion" [(ngModel)]="data.religion" />
          </label>
          <label class="field field-wide">
            <span>Chuy\xEAn ng\xE0nh/chuy\xEAn m\xF4n \u0111\xE3 \u0111\xE0o t\u1EA1o</span>
            <input type="text" name="trainedSpecialty" [(ngModel)]="data.trainedSpecialty" />
          </label>
        </div>
      </section>

      <section class="form-card">
        <div class="section-heading">
          <span>03</span>
          <div>
            <h2>T\xEDnh c\xE1ch, kinh nghi\u1EC7m v\xE0 m\u1EE5c ti\xEAu</h2>
            <p>Vi\u1EBFt ng\u1EAFn g\u1ECDn \u0111\u1EC3 n\u1ED9i dung hi\u1EC3n th\u1ECB t\u1ED1t trong c\xE1c \xF4 c\u1EE7a bi\u1EC3u m\u1EABu.</p>
          </div>
        </div>

        <div class="form-grid">
          <label class="field"
            ><span>\u0110i\u1EC3m m\u1EA1nh</span><input type="text" name="strengths" [(ngModel)]="data.strengths"
          /></label>
          <label class="field"
            ><span>\u0110i\u1EC3m y\u1EBFu</span
            ><input type="text" name="weaknesses" [(ngModel)]="data.weaknesses"
          /></label>
          <label class="field"
            ><span>S\u1EDF th\xEDch</span><input type="text" name="hobbies" [(ngModel)]="data.hobbies"
          /></label>
          <label class="field"
            ><span>Thu nh\u1EADp b\u1EA3n th\xE2n</span
            ><input
              type="text"
              name="personalIncome"
              [(ngModel)]="data.personalIncome"
              inputmode="numeric"
          /></label>
          <label class="field"
            ><span>Thu nh\u1EADp gia \u0111\xECnh</span
            ><input
              type="text"
              name="familyIncome"
              [(ngModel)]="data.familyIncome"
              inputmode="numeric"
          /></label>

          <fieldset class="choice-field">
            <legend>C\xF3 kinh nghi\u1EC7m s\u1ED1ng t\u1EADp th\u1EC3?</legend>
            <div class="choice-row">
              <label
                ><input
                  type="radio"
                  name="collectiveLiving"
                  value="yes"
                  [(ngModel)]="data.collectiveLiving"
                /><span>C\xF3</span></label
              >
              <label
                ><input
                  type="radio"
                  name="collectiveLiving"
                  value="no"
                  [(ngModel)]="data.collectiveLiving"
                /><span>Kh\xF4ng</span></label
              >
            </div>
          </fieldset>

          <fieldset class="choice-field">
            <legend>C\xF3 bi\u1EBFt n\u1EA5u \u0103n kh\xF4ng?</legend>
            <div class="choice-row">
              <label
                ><input type="radio" name="canCook" value="yes" [(ngModel)]="data.canCook" /><span
                  >C\xF3</span
                ></label
              >
              <label
                ><input type="radio" name="canCook" value="no" [(ngModel)]="data.canCook" /><span
                  >Kh\xF4ng</span
                ></label
              >
            </div>
          </fieldset>

          <label class="field field-full">
            <span>T\u1EF1 nh\u1EADn x\xE9t v\u1EC1 t\xEDnh c\xE1ch</span>
            <textarea name="selfAssessment" [(ngModel)]="data.selfAssessment" rows="3"></textarea>
          </label>
          <label class="field field-full">
            <span>L\xFD do \u0111i Nh\u1EADt</span>
            <textarea name="reasonJapan" [(ngModel)]="data.reasonJapan" rows="3"></textarea>
          </label>
          <label class="field field-wide">
            <span>S\u1ED1 ti\u1EC1n mu\u1ED1n mang v\u1EC1 sau 3 n\u0103m</span>
            <input type="text" name="savingsGoal" [(ngModel)]="data.savingsGoal" />
          </label>
          <label class="field field-wide">
            <span>D\u1EF1 \u0111\u1ECBnh sau 3 n\u0103m</span>
            <input type="text" name="futurePlan" [(ngModel)]="data.futurePlan" />
          </label>

          <fieldset class="choice-field">
            <legend>\u0110\xE3 t\u1EEBng ra n\u01B0\u1EDBc ngo\xE0i?</legend>
            <div class="choice-row">
              <label
                ><input
                  type="radio"
                  name="abroadBefore"
                  value="yes"
                  [(ngModel)]="data.abroadBefore"
                /><span>C\xF3</span></label
              >
              <label
                ><input
                  type="radio"
                  name="abroadBefore"
                  value="no"
                  [(ngModel)]="data.abroadBefore"
                /><span>Kh\xF4ng</span></label
              >
            </div>
          </fieldset>
          <label class="field"
            ><span>N\u01B0\u1EDBc n\xE0o?</span
            ><input type="text" name="abroadCountry" [(ngModel)]="data.abroadCountry"
          /></label>
          <label class="field"
            ><span>N\u0103m n\xE0o?</span
            ><input type="text" name="abroadYear" [(ngModel)]="data.abroadYear" inputmode="numeric"
          /></label>

          <fieldset class="choice-field">
            <legend>\u0110\xE3 \u0111\u0103ng k\xFD xin VISA Nh\u1EADt?</legend>
            <div class="choice-row">
              <label
                ><input
                  type="radio"
                  name="visaApplied"
                  value="yes"
                  [(ngModel)]="data.visaApplied"
                /><span>C\xF3</span></label
              >
              <label
                ><input
                  type="radio"
                  name="visaApplied"
                  value="no"
                  [(ngModel)]="data.visaApplied"
                /><span>Ch\u01B0a t\u1EEBng</span></label
              >
            </div>
          </fieldset>
        </div>
      </section>

      <section class="form-card">
        <div class="section-heading">
          <span>04</span>
          <div>
            <h2>Qu\xE1 tr\xECnh h\u1ECDc t\u1EADp</h2>
            <p>C\xF3 t\u1ED1i \u0111a 4 d\xF2ng t\u01B0\u01A1ng \u1EE9ng v\u1EDBi bi\u1EC3u m\u1EABu g\u1ED1c.</p>
          </div>
        </div>

        <div class="table-scroll">
          <table class="entry-table">
            <thead>
              <tr>
                <th>T\u1EEB th\xE1ng/n\u0103m</th>
                <th>\u0110\u1EBFn th\xE1ng/n\u0103m</th>
                <th>T\xEAn tr\u01B0\u1EDDng</th>
                <th>Chuy\xEAn ng\xE0nh</th>
              </tr>
            </thead>
            <tbody>
              <tr *ngFor="let entry of data.education; let i = index; trackBy: trackByIndex">
                <td data-label="T\u1EEB th\xE1ng/n\u0103m">
                  <input
                    type="text"
                    name="educationFrom{{ i }}"
                    [(ngModel)]="entry.from"
                    placeholder="09/2018"
                  />
                </td>
                <td data-label="\u0110\u1EBFn th\xE1ng/n\u0103m">
                  <input
                    type="text"
                    name="educationTo{{ i }}"
                    [(ngModel)]="entry.to"
                    placeholder="06/2021"
                  />
                </td>
                <td data-label="T\xEAn tr\u01B0\u1EDDng">
                  <input type="text" name="educationSchool{{ i }}" [(ngModel)]="entry.school" />
                </td>
                <td data-label="Chuy\xEAn ng\xE0nh">
                  <input type="text" name="educationMajor{{ i }}" [(ngModel)]="entry.major" />
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="study-status">
          <label
            ><input type="checkbox" name="studiedLate" [(ngModel)]="data.studiedLate" /><span
              >H\u1ECDc mu\u1ED9n</span
            ></label
          >
          <label
            ><input type="checkbox" name="studiedEarly" [(ngModel)]="data.studiedEarly" /><span
              >H\u1ECDc s\u1EDBm</span
            ></label
          >
          <label
            ><input type="checkbox" name="repeatedGrade" [(ngModel)]="data.repeatedGrade" /><span
              >H\u1ECDc l\u1EA1i</span
            ></label
          >
          <label class="field compact"
            ><span>N\u0103m n\xE0o?</span
            ><input type="text" name="studyStatusYear" [(ngModel)]="data.studyStatusYear"
          /></label>
        </div>
      </section>

      <section class="form-card">
        <div class="section-heading">
          <span>05</span>
          <div>
            <h2>Qu\xE1 tr\xECnh l\xE0m vi\u1EC7c</h2>
            <p>Khai ch\xEDnh x\xE1c t\xEAn c\xF4ng ty v\xE0 c\xF4ng vi\u1EC7c c\u1EE5 th\u1EC3 \u0111\xE3 l\xE0m.</p>
          </div>
        </div>

        <div class="table-scroll">
          <table class="entry-table">
            <thead>
              <tr>
                <th>T\u1EEB th\xE1ng/n\u0103m</th>
                <th>\u0110\u1EBFn th\xE1ng/n\u0103m</th>
                <th>T\xEAn c\xF4ng ty/n\u01A1i l\xE0m vi\u1EC7c</th>
                <th>N\u1ED9i dung c\xF4ng vi\u1EC7c</th>
              </tr>
            </thead>
            <tbody>
              <tr *ngFor="let entry of data.workHistory; let i = index; trackBy: trackByIndex">
                <td data-label="T\u1EEB th\xE1ng/n\u0103m">
                  <input type="text" name="workFrom{{ i }}" [(ngModel)]="entry.from" />
                </td>
                <td data-label="\u0110\u1EBFn th\xE1ng/n\u0103m">
                  <input type="text" name="workTo{{ i }}" [(ngModel)]="entry.to" />
                </td>
                <td data-label="T\xEAn c\xF4ng ty/n\u01A1i l\xE0m vi\u1EC7c">
                  <input type="text" name="workCompany{{ i }}" [(ngModel)]="entry.company" />
                </td>
                <td data-label="N\u1ED9i dung c\xF4ng vi\u1EC7c">
                  <input type="text" name="workJob{{ i }}" [(ngModel)]="entry.job" />
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="form-card">
        <div class="section-heading">
          <span>06</span>
          <div>
            <h2>Th\xE0nh ph\u1EA7n gia \u0111\xECnh</h2>
            <p>C\xF3 t\u1ED1i \u0111a 6 th\xE0nh vi\xEAn theo s\u1ED1 d\xF2ng c\u1EE7a bi\u1EC3u m\u1EABu.</p>
          </div>
        </div>

        <div class="table-scroll">
          <table class="entry-table family-table">
            <thead>
              <tr>
                <th>H\u1ECD v\xE0 t\xEAn</th>
                <th>Quan h\u1EC7</th>
                <th>N\u0103m sinh</th>
                <th>Ngh\u1EC1 nghi\u1EC7p</th>
                <th>N\u01A1i \u1EDF</th>
              </tr>
            </thead>
            <tbody>
              <tr *ngFor="let member of data.family; let i = index; trackBy: trackByIndex">
                <td data-label="H\u1ECD v\xE0 t\xEAn">
                  <input type="text" name="familyName{{ i }}" [(ngModel)]="member.fullName" />
                </td>
                <td data-label="Quan h\u1EC7">
                  <input
                    type="text"
                    name="familyRelationship{{ i }}"
                    [(ngModel)]="member.relationship"
                  />
                </td>
                <td data-label="N\u0103m sinh">
                  <input
                    type="text"
                    name="familyBirthYear{{ i }}"
                    [(ngModel)]="member.birthYear"
                    inputmode="numeric"
                  />
                </td>
                <td data-label="Ngh\u1EC1 nghi\u1EC7p">
                  <input
                    type="text"
                    name="familyOccupation{{ i }}"
                    [(ngModel)]="member.occupation"
                  />
                </td>
                <td data-label="N\u01A1i \u1EDF">
                  <div class="inline-radios">
                    <label>
                      <input
                        type="radio"
                        name="livingStatus{{ i }}"
                        value="together"
                        [(ngModel)]="member.livingStatus"
                      />
