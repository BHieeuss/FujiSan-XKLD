      <h2 id="registration-gate-title">Nh\u1EADp m\xE3 truy c\u1EADp 4 s\u1ED1</h2>
      <p>M\xE3 n\xE0y gi\xFAp VieJap x\xE1c nh\u1EADn b\u1EA1n \u0111ang m\u1EDF \u0111\xFAng bi\u1EC3u m\u1EABu \u0111\u0103ng k\xFD.</p>

      <label for="registration-pin">M\xE3 truy c\u1EADp</label>
      <div
        class="registration-pin-field"
        [class.is-valid]="isRegistrationPinValid"
        [class.is-invalid]="registrationPinInput.length === 4 && !isRegistrationPinValid"
      >
        <i class="fas fa-lock" aria-hidden="true"></i>
        <input
          #registrationPinField
          id="registration-pin"
          type="password"
          inputmode="numeric"
          pattern="[0-9]*"
          maxlength="4"
          autocomplete="one-time-code"
          placeholder="\u2022\u2022\u2022\u2022"
          [value]="registrationPinInput"
          (input)="onRegistrationPinInput($event)"
          (keydown.enter)="continueToRegistration()"
          aria-describedby="registration-pin-help"
        />
        <i
          *ngIf="isRegistrationPinValid"
          class="fas fa-check-circle registration-pin-check"
          aria-hidden="true"
        ></i>
      </div>

      <div
        id="registration-pin-help"
        class="registration-pin-message"
        [class.is-success]="isRegistrationPinValid"
        [class.is-error]="registrationPinInput.length === 4 && !isRegistrationPinValid"
