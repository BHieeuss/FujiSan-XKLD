  chooseQuizOption(option) {
    this.quizAnswers[this.currentQuizQuestion.id] = option;
    if (this.quizStep < this.quizQuestions.length - 1) {
      this.quizStep += 1;
      return;
    }
    this.quizResult = this.calculateQuizResult();
  }
  previousQuizQuestion() {
    if (this.quizStep > 0) {
