    </div>\r
  </div>\r
</section>

<!-- Ch\u01B0\u01A1ng tr\xECnh xu\u1EA5t c\u1EA3nh -->
<section class="programs-section py-5" id="chuong-trinh">
  <div class="container">
    <div class="programs-heading-row">
      <div class="programs-heading">
        <span class="programs-kicker">4 h\u01B0\u1EDBng \u0111i ph\u1ED5 bi\u1EBFn</span>
        <h2>Ch\u1ECDn ch\u01B0\u01A1ng tr\xECnh ph\xF9 h\u1EE3p v\u1EDBi b\u1EA1n</h2>
        <p>M\u1ED7i ch\u01B0\u01A1ng tr\xECnh c\xF3 \u0111i\u1EC1u ki\u1EC7n v\xE0 c\xE1ch chu\u1EA9n b\u1ECB kh\xE1c nhau. Xem \u1EA3nh th\u1EF1c t\u1EBF v\xE0 l\u1ED9 tr\xECnh tr\u01B0\u1EDBc khi l\u1EF1a ch\u1ECDn.</p>
      </div>

      <a
        class="programs-help-link"
        [href]="contactInfo.consultationUrl"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fas fa-comment-dots"></i>
        <span>
          <small>Ch\u01B0a r\xF5 m\xECnh ph\xF9 h\u1EE3p di\u1EC7n n\xE0o?</small>
          <strong>H\u1ECFi VieJap qua Zalo</strong>
        </span>
        <i class="fas fa-arrow-right"></i>
      </a>
    </div>

