  calculateQuizResult() {
    const scores = {
      "ky-su": 0,
      tokutei: 0,
      "thuc-tap-sinh": 0,
      "du-hoc-sinh": 0
    };
    Object.values(this.quizAnswers).forEach((answer) => {
      Object.entries(answer.scores).forEach(([key, score]) => {
        scores[key] += score ?? 0;
      });
    });
    const resultKey = Object.keys(scores).reduce((best, key) => scores[key] > scores[best] ? key : best);
    return this.quizResults[resultKey];
  }
