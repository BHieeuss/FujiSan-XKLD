        >
          <div class="program-card-media">
            <img [src]="item.coverImage" [alt]="item.coverAlt" loading="lazy" />
            <span class="program-card-badge">{{ item.badge }}</span>
          </div>

          <div class="program-card-body">
            <div class="program-card-title">
              <span class="program-icon"><i [class]="item.icon"></i></span>
              <h3>{{ item.label }}</h3>
            </div>
            <div class="program-description">{{ item.description }}</div>

            <div class="program-card-footer">
              <span>{{ item.supportText }}</span>
              <strong>
                Xem ch\u01B0\u01A1ng tr\xECnh
                <i class="fas fa-arrow-right"></i>
              </strong>
            </div>
          </div>
