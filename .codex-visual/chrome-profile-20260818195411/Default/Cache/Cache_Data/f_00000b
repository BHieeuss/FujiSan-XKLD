      </div>\r
    </div>\r
  </div>\r
</section>\r
\r
<div\r
  class="program-popup-overlay"\r
  *ngIf="isProgramPopupOpen"\r
  role="dialog"
  aria-modal="true"
  aria-labelledby="program-popup-title"
  (click)="closeProgramPopup()"
>
  <div
    class="program-popup-panel"
    [class.program-roadmap-active]="isProgramRoadmapOpen"
    (click)="$event.stopPropagation()"
  >
    <div class="program-popup-handle" aria-hidden="true"></div>
    <div class="program-modal-wrap">
      <header class="program-popup-header">
        <button
          *ngIf="isProgramRoadmapOpen"
          type="button"
          class="program-popup-back"
          (click)="showProgramOverview()"
        >
          <i class="fas fa-arrow-left"></i>
          <span>Quay l\u1EA1i</span>
        </button>

        <span *ngIf="!isProgramRoadmapOpen" class="program-popup-context">
          <i class="fas fa-compass"></i>
          T\xECm hi\u1EC3u ch\u01B0\u01A1ng tr\xECnh
        </span>

        <button
          type="button"
          class="program-popup-close"
          aria-label="\u0110\xF3ng th\xF4ng tin ch\u01B0\u01A1ng tr\xECnh"
          (click)="closeProgramPopup()"
        >
          <i class="fas fa-times"></i>
        </button>
      </header>

      <div class="program-popup-scroll">
        <ng-container *ngIf="!isProgramRoadmapOpen; else programRoadmapView">
          <div class="program-detail-layout">
            <figure class="program-detail-visual">
              <img
                [src]="selectedProgramDetail.images[0]"
                [alt]="selectedProgramDetail.title"
              />
              <figcaption>
                <i class="fas fa-camera"></i>
                H\xECnh \u1EA3nh trong m\xF4i tr\u01B0\u1EDDng h\u1ECDc t\u1EADp, l\xE0m vi\u1EC7c
              </figcaption>
            </figure>

            <div class="program-detail-copy">
              <span class="program-detail-kicker">{{ selectedProgramDetail.eyebrow }}</span>
              <h2 class="program-modal-title" id="program-popup-title">
                {{ selectedProgramDetail.title }}
              </h2>
              <p class="program-modal-subtitle">{{ selectedProgramDetail.subtitle }}</p>

              <div class="program-quick-facts">
                <article class="program-fact" *ngFor="let fact of selectedProgramDetail.facts">
                  <span class="program-fact-icon"><i [class]="fact.icon"></i></span>
                  <span>
                    <strong>{{ fact.title }}</strong>
                    <small>{{ fact.text }}</small>
                  </span>
                </article>
              </div>

              <div class="program-friendly-note">
                <i class="fas fa-comment-dots"></i>
                <p>{{ selectedProgramDetail.note }}</p>
              </div>
            </div>
          </div>

          <section class="program-photo-section">
            <div class="program-photo-heading">
              <strong>M\u1ED9t v\xE0i h\xECnh \u1EA3nh th\u1EF1c t\u1EBF</strong>
              <small>Xem nhanh m\xF4i tr\u01B0\u1EDDng c\u1EE7a ch\u01B0\u01A1ng tr\xECnh</small>
            </div>

            <div class="program-photo-strip">
              <figure
                *ngFor="let image of selectedProgramDetail.images | slice: 1; let index = index"
              >
                <img
                  [src]="image"
                  [alt]="'H\xECnh \u1EA3nh ' + selectedProgramDetail.title + ' ' + (index + 2)"
                  loading="lazy"
                />
              </figure>
            </div>
          </section>
        </ng-container>

        <ng-template #programRoadmapView>
          <section class="program-roadmap-view">
            <div class="program-roadmap-heading">
              <span class="program-detail-kicker">Xem t\u1EEBng b\u01B0\u1EDBc</span>
              <h2 class="program-modal-title" id="program-popup-title">
                L\u1ED9 tr\xECnh {{ selectedProgramDetail.title }}
              </h2>
              <p>
                \u0110\xE2y l\xE0 b\u1EE9c tranh t\u1ED5ng quan \u0111\u1EC3 b\u1EA1n d\u1EC5 h\xECnh dung. T\u1EEBng m\u1ED1c c\xF3 th\u1EC3 thay \u0111\u1ED5i
                m\u1ED9t ch\xFAt theo h\u1ED3 s\u01A1 v\xE0 th\u1EDDi \u0111i\u1EC3m \u0111\u0103ng k\xFD.
              </p>
            </div>

            <a
              class="program-roadmap-poster"
              [href]="selectedProgramDetail.guideImage"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                [src]="selectedProgramDetail.guideImage"
                [alt]="selectedProgramDetail.guideAlt"
              />
              <span>
                <i class="fas fa-expand-alt"></i>
                M\u1EDF \u1EA3nh r\xF5 h\u01A1n
              </span>
            </a>

            <div class="program-roadmap-note">
              <i class="fas fa-info-circle"></i>
              <span>
                B\u1EA1n kh\xF4ng c\u1EA7n t\u1EF1 chu\u1EA9n b\u1ECB m\u1ECDi th\u1EE9 m\u1ED9t m\xECnh. VieJap s\u1EBD c\xF9ng ki\u1EC3m tra t\u1EEBng
                b\u01B0\u1EDBc tr\u01B0\u1EDBc khi b\u1EAFt \u0111\u1EA7u.
              </span>
            </div>
          </section>
        </ng-template>
      </div>

      <footer class="program-popup-footer">
        <ng-container *ngIf="!isProgramRoadmapOpen; else programRoadmapActions">
          <button type="button" class="program-action program-action-primary" (click)="showProgramRoadmap()">
            <span class="program-action-icon"><i class="fas fa-route"></i></span>
            <span class="program-action-copy">
              <strong>Xem l\u1ED9 tr\xECnh</strong>
              <small>C\xE1c b\u01B0\u1EDBc chu\u1EA9n b\u1ECB t\u1EEB \u0111\u1EA7u \u0111\u1EBFn khi sang Nh\u1EADt</small>
            </span>
            <i class="fas fa-arrow-right program-action-arrow"></i>
          </button>

          <a
            class="program-action program-action-secondary"
            [href]="contactInfo.consultationUrl"
            target="_blank"
            rel="noopener noreferrer"
            (click)="closeProgramPopup()"
          >
            <span class="program-action-icon"><i class="fas fa-comment-dots"></i></span>
            <span class="program-action-copy">
              <strong>H\u1ECFi \u0111\u01A1n ph\xF9 h\u1EE3p</strong>
              <small>VieJap xem h\u1ED3 s\u01A1 v\xE0 trao \u0111\u1ED5i c\xF9ng b\u1EA1n</small>
            </span>
            <i class="fas fa-external-link-alt program-action-arrow"></i>
          </a>
        </ng-container>

        <ng-template #programRoadmapActions>
          <button type="button" class="program-action program-action-secondary" (click)="showProgramOverview()">
            <span class="program-action-icon"><i class="fas fa-arrow-left"></i></span>
            <span class="program-action-copy">
              <strong>Quay l\u1EA1i th\xF4ng tin</strong>
              <small>Xem \u0111i\u1EC1u ki\u1EC7n v\xE0 h\xECnh \u1EA3nh ch\u01B0\u01A1ng tr\xECnh</small>
            </span>
          </button>

          <a
            class="program-action program-action-primary"
            [href]="contactInfo.consultationUrl"
            target="_blank"
            rel="noopener noreferrer"
            (click)="closeProgramPopup()"
          >
            <span class="program-action-icon"><i class="fas fa-comment-dots"></i></span>
            <span class="program-action-copy">
              <strong>Nh\u1EAFn VieJap h\u1ECFi th\xEAm</strong>
              <small>Trao \u0111\u1ED5i tr\u1EF1c ti\u1EBFp qua Zalo</small>
            </span>
            <i class="fas fa-arrow-right program-action-arrow"></i>
          </a>
        </ng-template>
      </footer>
    </div>
  </div>
</div>

<section class="program-matcher-section py-5" id="phu-hop">
  <div class="container">
    <div class="matcher-layout">
      <div class="matcher-intro">
        <span class="section-kicker">
          <i class="fas fa-wand-magic-sparkles"></i>
          G\u1EE3i \xFD trong kho\u1EA3ng 1 ph\xFAt
        </span>
        <h2>B\u1EA1n ph\xF9 h\u1EE3p ch\u01B0\u01A1ng tr\xECnh n\xE0o?</h2>
        <p>
          Tr\u1EA3 l\u1EDDi 5 c\xE2u ng\u1EAFn v\u1EC1 m\u1EE5c ti\xEAu, b\u1EB1ng c\u1EA5p v\xE0 kinh nghi\u1EC7m. K\u1EBFt qu\u1EA3 ch\u1EC9 l\xE0 g\u1EE3i \xFD
          ban \u0111\u1EA7u, kh\xF4ng y\xEAu c\u1EA7u b\u1EA1n nh\u1EADp th\xF4ng tin c\xE1 nh\xE2n.
        </p>

        <div class="matcher-points">
          <span><i class="fas fa-shield-halved"></i>Kh\xF4ng l\u01B0u c\xE2u tr\u1EA3 l\u1EDDi</span>
          <span><i class="fas fa-list-check"></i>C\xF3 l\xFD do g\u1EE3i \xFD r\xF5 r\xE0ng</span>
          <span><i class="fas fa-rotate"></i>C\xF3 th\u1EC3 l\xE0m l\u1EA1i b\u1EA5t c\u1EE9 l\xFAc n\xE0o</span>
        </div>
      </div>

      <div class="matcher-card">
        <div class="matcher-progress" aria-hidden="true">
          <span [style.width.%]="quizProgress"></span>
        </div>

        <ng-container *ngIf="!quizResult; else quizResultView">
          <header class="matcher-question-head">
            <span>C\xE2u {{ quizStep + 1 }} / {{ quizQuestions.length }}</span>
            <button
              *ngIf="quizStep > 0"
              type="button"
              (click)="previousQuizQuestion()"
            >
              <i class="fas fa-arrow-left"></i>
              Quay l\u1EA1i
            </button>
          </header>

          <h3>{{ currentQuizQuestion.title }}</h3>
          <p class="matcher-question-description">{{ currentQuizQuestion.description }}</p>

          <div class="matcher-options">
            <button
              *ngFor="let option of currentQuizQuestion.options"
              type="button"
              class="matcher-option"
              (click)="chooseQuizOption(option)"
            >
              <span class="matcher-option-check"><i class="fas fa-check"></i></span>
              <span>
                <strong>{{ option.label }}</strong>
                <small>{{ option.detail }}</small>
              </span>
              <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </ng-container>

        <ng-template #quizResultView>
          <div class="matcher-result">
            <span class="matcher-result-icon"><i [class]="quizResult?.icon"></i></span>
            <span class="matcher-result-kicker">G\u1EE3i \xFD ph\xF9 h\u1EE3p nh\u1EA5t</span>
            <h3>{{ quizResult?.title }}</h3>
            <p>{{ quizResult?.summary }}</p>
            <div class="matcher-result-reason">
              <i class="fas fa-lightbulb"></i>
              <span>{{ quizResult?.reason }}</span>
            </div>

            <div class="matcher-result-actions">
              <button type="button" class="matcher-primary" (click)="viewQuizProgram()">
                Xem ch\u01B0\u01A1ng tr\xECnh
                <i class="fas fa-arrow-right"></i>
              </button>
              <button type="button" class="matcher-secondary" (click)="resetQuiz()">
                <i class="fas fa-rotate-left"></i>
                L\xE0m l\u1EA1i
              </button>
            </div>

            <small class="matcher-disclaimer">
              G\u1EE3i \xFD n\xE0y kh\xF4ng thay th\u1EBF vi\u1EC7c ki\u1EC3m tra h\u1ED3 s\u01A1, s\u1EE9c kh\u1ECFe v\xE0 \u0111i\u1EC1u ki\u1EC7n c\u1EE7a t\u1EEBng \u0111\u01A1n tuy\u1EC3n.
            </small>
          </div>
        </ng-template>
      </div>
    </div>
  </div>
</section>

<section class="featured-orders-section py-5" id="don-tuyen">
  <div class="container">
    <div class="orders-heading">
      <div>
        <span class="section-kicker">
          <i class="fas fa-list-check"></i>
          \u0110\u01A1n tuy\u1EC3n \u0111ang m\u1EDF
        </span>
        <h2>Xem v\u1ECB tr\xED \u0111ang tuy\u1EC3n tr\u01B0\u1EDBc khi quy\u1EBFt \u0111\u1ECBnh</h2>
        <p>
          Danh s\xE1ch b\xEAn d\u01B0\u1EDBi l\u1EA5y tr\u1EF1c ti\u1EBFp t\u1EEB Sheet c\u1EE7a VieJap \u0111\u1EC3 b\u1EA1n xem ng\xE0nh ngh\u1EC1,
          \u0111i\u1EC1u ki\u1EC7n, khu v\u1EF1c v\xE0 ghi ch\xFA m\u1EDBi nh\u1EA5t.
        </p>
