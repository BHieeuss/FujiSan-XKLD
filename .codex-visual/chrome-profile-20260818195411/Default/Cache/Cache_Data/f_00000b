        <i class="fas fa-filter-circle-dollar"></i>
        <strong>\u0110\u1EEBng ch\u1EC9 nh\xECn m\u1EE9c l\u01B0\u01A1ng</strong>
        <span>N\xEAn xem c\u1EA3 ti\u1EC1n nh\xE0, b\u1EA3o hi\u1EC3m, gi\u1EDD l\xE0m v\xE0 kho\u1EA3n kh\u1EA5u tr\u1EEB.</span>
      </article>
      <article>
        <i class="fas fa-file-signature"></i>
        <strong>\u0110\u1ED1i chi\u1EBFu tr\u01B0\u1EDBc khi k\xFD</strong>
        <span>\u0110i\u1EC1u ki\u1EC7n v\xE0 chi ph\xED c\u1EA7n \u0111\u01B0\u1EE3c ghi r\xF5 trong h\u1ED3 s\u01A1, h\u1EE3p \u0111\u1ED3ng.</span>
      </article>
      <article>
        <i class="fas fa-comment-dots"></i>
        <strong>H\u1ECFi khi ch\u01B0a r\xF5</strong>
        <span>G\u1EEDi m\xE3 \u0111\u01A1n qua Zalo \u0111\u1EC3 VieJap ki\u1EC3m tra c\xF9ng b\u1EA1n.</span>
      </article>
    </div>
  </div>
</section>

<!-- Ch\xEDnh s\xE1ch h\u1ED7 tr\u1EE3 -->
<section class="policy-section py-5" id="chinh-sach">
  <div class="container">
    <div class="policy-section-head">
      <div>
        <span class="about-section-label">
          <i class="fas fa-book-open me-2"></i>Th\xF4ng tin c\u1EA7n bi\u1EBFt
        </span>
        <h2 class="about-section-title">Hi\u1EC3u \u0111\xFAng quy\u1EC1n l\u1EE3i tr\u01B0\u1EDBc khi quy\u1EBFt \u0111\u1ECBnh</h2>
        <p class="about-section-desc">
          VieJap t\xF3m t\u1EAFt l\u1EA1i b\u1EB1ng c\xE1ch d\u1EC5 \u0111\u1ECDc v\xE0 g\u1EAFn ngu\u1ED3n ch\xEDnh th\u1EE9c \u0111\u1EC3 b\u1EA1n ch\u1EE7 \u0111\u1ED9ng ki\u1EC3m tra.
        </p>
      </div>

      <div class="policy-verified">
        <i class="fas fa-check-circle"></i>
        <span>
          <small>\u0110\u1ED1i chi\u1EBFu ngu\u1ED3n ch\xEDnh th\u1EE9c</small>
          <strong>C\u1EADp nh\u1EADt {{ policyVerifiedOn }}</strong>
        </span>
      </div>
    </div>

    <div class="policy-tabs" role="tablist" aria-label="Ch\u1ECDn nh\xF3m th\xF4ng tin">
      <button
        *ngFor="let category of policyCategories"
        type="button"
        class="policy-tab"
        role="tab"
        [class.active]="category.id === selectedPolicyId"
        [attr.aria-selected]="category.id === selectedPolicyId"
        [attr.aria-controls]="category.id + '-panel'"
        (click)="selectPolicy(category.id)"
      >
        <span class="policy-tab-icon"><i [class]="category.icon"></i></span>
        <span>
          <strong>{{ category.title }}</strong>
          <small>{{ category.summary }}</small>
        </span>
        <i class="fas fa-chevron-right policy-tab-arrow"></i>
      </button>
    </div>

    <div class="policy-detail" [ngSwitch]="selectedPolicyId">
