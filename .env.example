# VieJap Environment Configuration Example
# Sao chép file này thành .env hoặc thiết lập trong môi trường máy chủ sản xuất cPanel

# 1. Google Gemini AI API Key (Dùng cho OCR đọc đơn hàng và QA poster)
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_VISION_MODEL=gemini-2.0-flash

# 2. Image Search Providers (Tìm kiếm ảnh đơn hàng)
# Google Programmable Search Engine (Google Images JSON API)
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_SEARCH_CX=your_google_search_engine_cx_id_here

# Pixabay Image API (Kho ảnh bản quyền thương mại miễn phí)
PIXABAY_API_KEY=your_pixabay_api_key_here

# 3. Quản lý lưu trữ ảnh & Tự động xóa sau 5 ngày
ORDER_IMAGE_RETENTION_DAYS=5
ORDER_IMAGE_MAX_SIZE_MB=10

# 4. Quản trị VieJap
VIEJAP_ADMIN_STORAGE=.local-data/admin

